{
  "name": "crate-digger",
  "version": "1.0.0",
  "private": true,
  "description": "A walk-in record room for a Spotify saved-album library: LPs in wooden crates, flipped by hand, next to a turntable.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:perf": "cross-env PERF=1 playwright test --project=perf",
    "mock": "python3 -m ingest.run mock --out data",
    "size": "node scripts/check-bundle-size.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@nanostores/preact": "^1.1.0",
    "nanostores": "^1.5.4",
    "postprocessing": "^6.39.5",
    "preact": "^10.29.8",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/three": "~0.186.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "lil-gui": "^0.21.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
