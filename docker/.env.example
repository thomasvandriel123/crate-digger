# Copy to docker/.env (gitignored) and fill in.

# --- web ------------------------------------------------------------------------------------------------
# A domain gets automatic HTTPS. Use ":80" to serve plain HTTP behind a VPN (e.g. Tailscale) or another proxy.
SITE_ADDRESS=crates.example.com
# public: open website (demo crates; visitors upload their Spotify export or, if invited, connect Spotify).
# private: everything behind basic auth and kept out of search engines (the two BASIC_AUTH_ lines below).
ACCESS=public
# Only for ACCESS=private:
BASIC_AUTH_USER=digger
# Bcrypt hash, single-quoted so the $ signs are taken literally:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'a long passphrase'
BASIC_AUTH_HASH='$2a$14$replace.this.with.your.own.hash.............................'

# --- Spotify --------------------------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard (Web API + Web Playback SDK; no secret needed).
# Register these redirect URIs on it:
#   https://crates.example.com/            (the viewer's "Connect Spotify"; your SITE_ADDRESS, trailing slash)
#   http://127.0.0.1:8888/callback          (the optional ingest)
# The client id is baked into the viewer at build time: rebuild (`up -d --build`) after changing it.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# MusicBrainz asks for contact info in the User-Agent (used only with --enrich).
MUSICBRAINZ_CONTACT=you@example.com
